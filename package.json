{
  "name": "filekit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run build:worker && next dev",
    "build": "npm run build:worker && node scripts/bg-assets.mjs --pages && next build",
    "preview": "serve --listen tcp://127.0.0.1:4173 --no-port-switching --config ../serve.json out",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e",
    "build:worker": "node scripts/build-worker.mjs && node scripts/bg-assets.mjs --runtime-only",
    "bg:prepare": "node scripts/bg-bench/prepare.mjs",
    "bg:dev": "node scripts/bg-bench/server.mjs",
    "bg:bench": "node scripts/bg-bench/run.mjs",
    "postinstall": "patch-package --error-on-fail",
    "bg:assets": "node scripts/bg-assets.mjs"
  },
  "dependencies": {
    "@bg0/browser": "file:vendor/bg0-browser-0.1.2.tgz",
    "@discourse/gif": "^1.0.0",
    "@huggingface/transformers": "4.3.0",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "comlink": "^4.4.2",
    "exifreader": "^4.55.1",
    "fflate": "^0.8.3",
    "libheif-js": "^1.23.5",
    "lucide-react": "^1.80.0",
    "next": "^16.4.6",
    "patch-package": "8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@webgpu/types": "0.1.74",
    "esbuild": "^0.28.2",
    "onnxruntime-web": "1.25.1",
    "postcss": "^8.5.33",
    "serve": "^14.2.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
